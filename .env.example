BOT_TOKEN=TOKEN

# ID администраторов через запятую (первый получает уведомления)
ADMIN_IDS=123456789

# Необязательно: прокси для запросов к Telegram API (например, http://127.0.0.1:7890)
PROXY_URL=

POSTGRES_DB=test_ariquantum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# При продакшене изменить на False (логирует все по БД)
DEBUG=False

LOG_FORMAT="[{asctime}] #{levelname:8} {filename}:{lineno} - {name} - {message}"
LOG_LEVEL=INFO
