BOT_TOKEN=TOKEN

POSTGRES_DB=test_ariquantum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# При продакшене изменить на False (логирует все по БД)
DEBUG=False

LOG_FORMAT="[{asctime}] #{levelname:8} {filename}:{lineno} - {name} - {message}"
LOG_LEVEL=INFO
